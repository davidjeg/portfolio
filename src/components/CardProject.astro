---
interface Props{
    id: number
    name: string
    description: string
}
const {id,name,description} = Astro.props as Props
---

<a class="grow basis-40 cursor-pointer rounded-xl">
    <div class="w-full h-60 rounded-md overflow-hidden">
    <img class="w-full h-full object-cover" src={`./projects/project-${id}.png`} alt="project"/>
    </div>
    <p class="text-center mt-3">{name}</p>

</a>
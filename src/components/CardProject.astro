---
interface Props{
    id: number
    name: string
    description: string
    url:string
}
const {id,name,description,url} = Astro.props as Props
---

<a href={url} class="cursor-pointer rounded-xl hover:scale-105 transition-transform duration-300">
    <div class="h-60 rounded-md overflow-hidden">
    <img class="h-full w-full object-cover object-top" src={`./projects/project-${id}.png`} alt="project"/>
    </div>
    <p class="text-renter mt-3 font-semibold">{name}</p>

</a>
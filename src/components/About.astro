---
import Container from "./Container.astro";
import CardProjectAstroComponent from "./CardProject.astro";
---

<Container id="about" class="md:py-24 py-16">
  <div class="grid md:grid-cols-2 lg:gap-16 gap-6 grid-cols-1">
    <img class="rounded-2xl" src="./about-me.png" alt="about-me img" />
    <div class="self-center">
      <h2 class="text-3xl font-semibold mb-4">About Me</h2>
      <p class="leading-relaxed">I'm a Computer Science Engineer with experience in both frontend and backend development. I enjoy building responsive, high-performance web applications with clean code, intuitive user interfaces, and scalable architectures. My goal is to create digital products that combine functionality, performance, and great user experience.
</p>
    </div>
  </div>
</Container>
